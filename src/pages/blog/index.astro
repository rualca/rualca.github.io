---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base
  title="Writing — Rubén Alapont"
  description="Articles on engineering leadership, architecture and shipping software."
  canonical="https://rualca.github.io/blog/"
>
  <main class="mx-auto max-w-3xl px-6 py-24">
    <h1 class="mb-2 text-4xl font-semibold tracking-tight">Writing</h1>
    <p class="mb-12 text-lg opacity-70">
      Articles on engineering leadership, architecture and shipping software.
    </p>

    {posts.length === 0 && <p class="opacity-70">Nothing published yet.</p>}

    <ul class="space-y-10">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`} class="group block">
            <h2 class="text-2xl font-medium group-hover:underline">{post.data.title}</h2>
            <p class="mt-1 opacity-70">{post.data.description}</p>
          </a>
          <time datetime={post.data.pubDate.toISOString()} class="mt-2 block text-sm opacity-60">
            {post.data.pubDate.toISOString().slice(0, 10)}
          </time>
          {post.data.tags.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-2 text-sm">
              {post.data.tags.map((tag) => (
                <li class="rounded-full border border-current/20 px-3 py-0.5 opacity-70">{tag}</li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>

    <p class="mt-16"><a href="/" class="underline">← Back to the site</a></p>
  </main>
</Base>
