---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const canonical = post.data.canonical ?? new URL(`/blog/${post.id}/`, Astro.site).href;
---

<Base title={`${post.data.title} — Rubén Alapont`} description={post.data.description} canonical={canonical}>
  <main class="mx-auto max-w-3xl px-6 py-24">
    <p class="mb-6 text-sm opacity-60">
      <a href="/blog/" class="underline">Writing</a>
      <span aria-hidden="true"> / </span>
      <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(0, 10)}</time>
    </p>

    <article class="prose">
      <h1 class="mb-6 text-4xl font-semibold tracking-tight">{post.data.title}</h1>
      <Content />
    </article>

    {post.data.tags.length > 0 && (
      <ul class="mt-12 flex flex-wrap gap-2 text-sm">
        {post.data.tags.map((tag) => (
          <li class="rounded-full border border-current/20 px-3 py-0.5 opacity-70">{tag}</li>
        ))}
      </ul>
    )}
  </main>
</Base>
