---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { tagUrl } from '../../lib/tags';

export async function getStaticPaths() {
  // Publication order, newest first, matching /blog. Collected here because
  // Astro compiles this function apart from the template below.
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  // Shared tags, then recency. Related links are how a reader moves sideways
  // through the archive instead of only forward and back in time.
  const relatedFor = (post) =>
    posts
      .filter((other) => other.id !== post.id)
      .map((other) => ({
        other,
        shared: other.data.tags.filter((tag) => post.data.tags.includes(tag)).length,
      }))
      .filter((entry) => entry.shared > 0)
      .sort(
        (a, b) =>
          b.shared - a.shared ||
          b.other.data.pubDate.valueOf() - a.other.data.pubDate.valueOf(),
      )
      .slice(0, 3)
      .map((entry) => entry.other);

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      // In date order the older article is "previous", the newer one "next".
      older: posts[index + 1] && { id: posts[index + 1].id, title: posts[index + 1].data.title },
      newer: posts[index - 1] && { id: posts[index - 1].id, title: posts[index - 1].data.title },
      related: relatedFor(post),
    },
  }));
}

const { post, older, newer, related } = Astro.props;
const { Content } = await render(post);

const site = (Astro.site?.href ?? 'https://rualca.github.io/').replace(/\/$/, '');
const canonical = post.data.canonical ?? new URL(`/blog/${post.id}/`, Astro.site).href;

// The article's own first image when it has one, so the card matches the page.
// It is omitted rather than invented when the article has no image.
const firstImage = post.body?.match(/!\[[^\]]*\]\(([^)\s]+)\)/)?.[1];
const image = firstImage ? new URL(firstImage, site).href : undefined;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  inLanguage: 'en',
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  author: { '@type': 'Person', name: 'Rubén Alapont', url: `${site}/` },
  publisher: { '@type': 'Person', name: 'Rubén Alapont', url: `${site}/` },
  isPartOf: { '@type': 'Blog', '@id': `${site}/blog/`, name: 'Writing — Rubén Alapont' },
  ...(image && { image }),
  ...(post.data.tags.length > 0 && { keywords: post.data.tags.join(', ') }),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Writing', item: `${site}/blog/` },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
  ],
};
---

<Base
  title={`${post.data.title} — Rubén Alapont`}
  description={post.data.description}
  canonical={canonical}
  ogType="article"
  publishedTime={post.data.pubDate.toISOString()}
  tags={post.data.tags}
  image={image}
  jsonLd={[articleLd, breadcrumbLd]}
>
  <main class="mx-auto max-w-3xl px-6 py-24">
    <p class="mb-6 text-sm opacity-60">
      <a href="/blog/" class="underline">Writing</a>
      <span aria-hidden="true"> / </span>
      <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(0, 10)}</time>
    </p>

    <article class="prose">
      <h1 class="mb-6 text-4xl font-semibold tracking-tight">{post.data.title}</h1>
      <Content />
    </article>

    {post.data.tags.length > 0 && (
      <ul class="mt-12 flex flex-wrap gap-2 text-sm">
        {post.data.tags.map((tag) => (
          <li>
            <a
              href={tagUrl(tag)}
              class="block rounded-full border border-current/20 px-3 py-0.5 opacity-70 hover:opacity-100"
            >
              #{tag}
            </a>
          </li>
        ))}
      </ul>
    )}

    {related.length > 0 && (
      <section class="mt-16 border-t border-border pt-8" aria-labelledby="related-heading">
        <h2 id="related-heading" class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
          Related reading
        </h2>
        <ul class="mt-4 space-y-2">
          {related.map((entry) => (
            <li>
              <a href={`/blog/${entry.id}/`} class="group flex items-baseline gap-2">
                <span class="font-medium group-hover:underline">{entry.data.title}</span>
                <span aria-hidden="true" class="text-muted-foreground">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {(older || newer) && (
      <nav class="mt-16 grid gap-6 border-t border-border pt-8 sm:grid-cols-2" aria-label="More articles">
        {older && (
          <a href={`/blog/${older.id}/`} class="group">
            <span class="block text-xs text-muted-foreground">Previous</span>
            <span class="mt-1 block font-medium group-hover:underline">{older.title}</span>
          </a>
        )}
        {newer && (
          <a href={`/blog/${newer.id}/`} class="group sm:text-right">
            <span class="block text-xs text-muted-foreground">Next</span>
            <span class="mt-1 block font-medium group-hover:underline">{newer.title}</span>
          </a>
        )}
      </nav>
    )}
  </main>
</Base>
