---
import '../index.css';
import '../App.css';
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.jsx';
import Hero from '../components/hero';
import Experience from '../components/Experience.jsx';
import BelowFold from '../BelowFold.jsx';
import SmoothScroll from '../components/SmoothScroll.jsx';
---

<Base>
  <Navbar client:load />
  <main>
    <Hero client:load />
    <Experience client:load />
    {/*
      The below-fold sections are their own island. client:visible hands the
      "wait until it is needed" job to Astro, which replaces the hand-rolled
      timer and interaction listeners the single island needed: hydration
      starts when the section scrolls into view, on every viewport.
    */}
    <BelowFold client:visible />
  </main>
  <SmoothScroll client:idle />
</Base>
