---
import '../index.css';
import Base from '../layouts/Base.astro';
import App from '../App.jsx';
---

<Base>
  {/*
    The whole island is client-only: the site is still the same React app in
    this slice, and rendering it on the server would duplicate the DOM that the
    app already produces on mount. The <noscript> block in Base.astro is what
    crawlers and no-JS clients read for now; P3 replaces this with static
    article pages.
  */}
  <App client:only="react" />
</Base>
